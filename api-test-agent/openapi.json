{
  "openapi": "3.0.0",
  "info": {
    "title": "Mock Business API",
    "version": "2.0.0",
    "description": "模拟电商业务接口，用于自动化测试。错误响应统一格式: {\"code\": <status>, \"message\": \"<msg>\"}，不含 detail 字段"
  },
  "paths": {
    "/api/user/login": {
      "post": {
        "summary": "用户登录",
        "description": "任何符合格式要求的用户名密码均可登录成功（模拟环境）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "3-20位，仅字母数字下划线",
                    "example": "admin"
                  },
                  "password": {
                    "type": "string",
                    "description": "6-20位",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功，返回token和用户信息。响应结构: {\"code\":0,\"message\":\"success\",\"data\":{\"token\":\"...\",\"username\":\"...\"}}"
          },
          "422": {
            "description": "参数校验失败（Pydantic validation），响应结构: {\"detail\":[{\"msg\":\"...\"}]}"
          }
        }
      }
    },
    "/api/user/info": {
      "get": {
        "summary": "获取当前用户信息",
        "description": "需要在请求头中携带有效 token",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "Bearer token，token 值为 mock-token-2024",
            "schema": {
              "type": "string"
            },
            "example": "Bearer mock-token-2024"
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回用户信息。响应结构: {\"code\":0,\"data\":{\"id\":1,\"username\":\"admin\"}}"
          },
          "401": {
            "description": "未授权。响应结构: {\"code\":401,\"message\":\"...\"}。401 响应不含 detail 字段，用 code 和 message 替代"
          }
        }
      }
    },
    "/api/product/list": {
      "get": {
        "summary": "商品列表（分页+搜索）",
        "description": "分页查询商品，支持关键词搜索。超页返回空列表。",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码，>=1，默认1",
            "schema": { "type": "integer", "default": 1 },
            "example": 1
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "每页数量，1-100，默认10",
            "schema": { "type": "integer", "default": 10 },
            "example": 10
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "搜索关键词，最长50字符",
            "schema": { "type": "string" },
            "example": ""
          }
        ],
        "responses": {
          "200": {
            "description": "成功。响应结构: {\"code\":0,\"data\":{\"list\":[...],\"total\":100}}"
          },
          "400": {
            "description": "参数超出范围（page<1, page_size<1 或 >100, keyword>50）。响应结构: {\"code\":400,\"message\":\"...\"}"
          }
        }
      }
    },
    "/api/order/create": {
      "post": {
        "summary": "创建订单",
        "description": "需要 token 鉴权。product_id 有效范围 1-100。",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "Bearer token，值为 mock-token-2024",
            "schema": { "type": "string" },
            "example": "Bearer mock-token-2024"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["product_id", "count"],
                "properties": {
                  "product_id": {
                    "type": "integer",
                    "description": "商品ID，>=1 且在系统中存在（1-100）",
                    "example": 1
                  },
                  "count": {
                    "type": "integer",
                    "description": "购买数量，1-999",
                    "example": 2
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "订单创建成功。响应结构: {\"code\":0,\"data\":{\"order_id\":...,\"status\":\"created\"}}"
          },
          "400": {
            "description": "参数错误或库存不足。响应结构: {\"code\":400,\"message\":\"...\"}"
          },
          "401": {
            "description": "未授权（缺少 token 或 token 无效）。响应结构: {\"code\":401,\"message\":\"...\"}。不含 detail 字段"
          },
          "404": {
            "description": "商品不存在。响应结构: {\"code\":404,\"message\":\"...\"}"
          },
          "422": {
            "description": "参数类型错误或 Pydantic 校验失败。响应结构: {\"detail\":[{\"msg\":\"...\"}]}"
          }
        }
      }
    }
  }
}
